<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_10"
    android:paddingRight="@dimen/vs_10">

    <!-- 手机版：影片展示区位于分类行下方，占据按钮栏以上的全部空间 -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="false"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
        app:tv_selectedItemIsCentered="false"
        app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

    <!-- 手机版：历史、直播、搜索、收藏、设置 统一放到底部，顺序：直播、历史、收藏、搜索、设置 -->
    <LinearLayout
        android:id="@+id/userBottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_60"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tvLive"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_2"
            android:layout_marginRight="@dimen/vs_2"
            android:layout_weight="1"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/vs_4">

            <ImageView
                android:layout_width="@dimen/vs_25"
                android:layout_height="@dimen/vs_25"
                android:alpha="0.75"
                android:src="@drawable/icon_live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="直播"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvHistory"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_2"
            android:layout_marginRight="@dimen/vs_2"
            android:layout_weight="1"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/vs_4">

            <ImageView
                android:layout_width="@dimen/vs_25"
                android:layout_height="@dimen/vs_25"
                android:alpha="0.75"
                android:src="@drawable/icon_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="历史"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvFavorite"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_2"
            android:layout_marginRight="@dimen/vs_2"
            android:layout_weight="1"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/vs_4">

            <ImageView
                android:layout_width="@dimen/vs_25"
                android:layout_height="@dimen/vs_25"
                android:alpha="0.75"
                android:src="@drawable/icon_collect" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="收藏"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvSearch"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_2"
            android:layout_marginRight="@dimen/vs_2"
            android:layout_weight="1"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/vs_4">

            <ImageView
                android:layout_width="@dimen/vs_25"
                android:layout_height="@dimen/vs_25"
                android:alpha="0.75"
                android:src="@drawable/icon_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="搜索"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tvSetting"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_2"
            android:layout_marginRight="@dimen/vs_2"
            android:layout_weight="1"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/vs_4">

            <ImageView
                android:layout_width="@dimen/vs_25"
                android:layout_height="@dimen/vs_25"
                android:alpha="0.75"
                android:src="@drawable/icon_setting" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_2"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:text="设置"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
