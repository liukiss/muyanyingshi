<?xml version="1.0" encoding="utf-8"?>
<!-- 手机版：指定搜索源弹窗，窗口由 SearchCheckboxDialog.show() 按手机尺寸设置，不再铺满全屏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_pg_search_checkbox"
        android:orientation="vertical"
        android:padding="@dimen/vs_10">

        <LinearLayout
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/checkAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_30"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14"
                android:text="全选" />

            <TextView
                android:id="@+id/clearAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_30"
                android:layout_marginLeft="@dimen/vs_8"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:text="全不选"
                android:textColor="@color/dialog_text_primary"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_weight="1"
            android:orientation="vertical" />

    </LinearLayout>

</FrameLayout>
