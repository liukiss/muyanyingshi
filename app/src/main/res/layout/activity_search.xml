<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/vs_10">

    <!-- 顶部搜索行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_weight="1"
            android:background="@drawable/input_search"
            android:hint="请输入要搜索的内容"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:textColor="@android:color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvClear"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_5"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:text="清空"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <TextView
            android:id="@+id/tvSearch"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_5"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:text="搜索"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />
    </LinearLayout>

    <!-- 热词/历史/指定源 行 -->
    <LinearLayout
        android:id="@+id/llWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wordSwitch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_50"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:text="热词 | 历史"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvSearchCheckboxBtn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_5"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_10"
            android:paddingRight="@dimen/vs_10"
            android:text="指定搜索源"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridViewWord"
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_50"
            android:layout_marginLeft="@dimen/vs_5"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="false"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>

    <!-- 历史词流式区（聚合搜索模式下显示） -->
    <LinearLayout
        android:id="@+id/llHistoryWord"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_10"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_50"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_50"
                android:gravity="center_vertical"
                android:letterSpacing="0.08"
                android:text="历  史"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold" />

            <Space
                android:layout_width="@dimen/vs_0"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/tvHistoryClear"
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:background="@drawable/shape_user_focus"
                android:focusable="true"
                android:padding="@dimen/vs_5"
                android:src="@drawable/icon_delete" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/historyWordGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:columnCount="1"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- 搜索结果区 -->
    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/vs_10"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="invisible"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_5"
            app:tv_selectedItemIsCentered="false"
            app:tv_verticalSpacingWithMargins="@dimen/vs_5" />
    </LinearLayout>

    <!-- TV 屏幕键盘：手机版隐藏保留 -->
    <com.github.tvbox.osc.ui.tv.widget.SearchKeyboard
        android:id="@+id/keyBoardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- 遥控器二维码区：手机版隐藏保留 -->
    <LinearLayout
        android:id="@+id/remoteRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/vs_20"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_20" />

        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_300"
            android:layout_height="@dimen/vs_300"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/vs_20"
            tools:ignore="InOrMmUsage" />
    </LinearLayout>
</LinearLayout>
