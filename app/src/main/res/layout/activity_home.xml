<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_45"
        android:layout_marginTop="@dimen/vs_0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_15"
        android:paddingRight="@dimen/vs_15"
        android:paddingTop="@dimen/vs_0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="left|center_vertical"
            android:text="@string/app_name"
            android:textAlignment="gravity"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_30"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="@dimen/vs_0"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:visibility="gone"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="right|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAlignment="gravity"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ts_26"
            tools:text="2026/06/16  周二  15:01" />

        <Space
            android:layout_width="@dimen/vs_0"
            android:layout_height="@dimen/vs_1"
            android:layout_weight="1" />

        <!-- 手机版：收藏按钮只保留图标，位于“推送”左侧 -->
        <ImageView
            android:id="@+id/tvCollectHome"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:layout_marginLeft="@dimen/vs_6"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:padding="@dimen/vs_8"
            android:scaleType="centerInside"
            android:src="@drawable/icon_collect" />

        <!-- 手机版：推送按钮只保留图标，缩小后位于原“换源”位置 -->
        <ImageView
            android:id="@+id/tvPushHome"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:layout_marginLeft="@dimen/vs_6"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:padding="@dimen/vs_8"
            android:scaleType="centerInside"
            android:src="@drawable/icon_push" />

        <!-- 手机版：换源改为图标按钮，样式与左侧图标一致 -->
        <ImageView
            android:id="@+id/tvChangeSourceHome"
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:layout_marginLeft="@dimen/vs_6"
            android:background="@drawable/shape_user_focus"
            android:focusable="true"
            android:padding="@dimen/vs_8"
            android:scaleType="centerInside"
            android:src="@drawable/icon_change_source" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_4"
            android:layout_marginBottom="@dimen/vs_4"
            android:paddingLeft="@dimen/vs_12"
            android:paddingRight="@dimen/vs_12"
            app:tv_selectedItemIsCentered="false" />

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
