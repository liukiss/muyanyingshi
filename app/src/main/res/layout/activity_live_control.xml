<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部直播播放器：16:9 原始比例 -->
        <FrameLayout
            android:id="@+id/playerLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_200"
            android:background="@android:color/black">

            <xyz.doikki.videoplayer.player.VideoView
                android:id="@+id/mVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/pbLiveLoading"
                android:layout_width="@dimen/vs_40"
                android:layout_height="@dimen/vs_40"
                android:layout_gravity="center"
                android:indeterminateDrawable="@drawable/anim_loading"
                android:indeterminateOnly="true" />

            <!-- 点击播放器区域进入全屏直播 -->
            <View
                android:id="@+id/playerClickArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="false" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_30"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/vs_10"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_12"
                android:paddingRight="@dimen/vs_12"
                android:text="返回"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_14" />

            <TextView
                android:id="@+id/tvPlayerChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/vs_10"
                android:focusable="false"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                tools:text="CCTV1" />

            <TextView
                android:id="@+id/tvFullscreenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/vs_10"
                android:background="@drawable/shape_live_control_btn"
                android:focusable="false"
                android:paddingLeft="@dimen/vs_8"
                android:paddingRight="@dimen/vs_8"
                android:paddingTop="@dimen/vs_2"
                android:paddingBottom="@dimen/vs_2"
                android:text="点击全屏"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_10" />
        </FrameLayout>

        <!-- 频道信息区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/vs_12">

            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:focusable="false"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_24"
                tools:text="CCTV1 综合" />

            <TextView
                android:id="@+id/tvChannelMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_4"
                android:ellipsize="end"
                android:focusable="false"
                android:singleLine="true"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_14"
                tools:text="直播 · 源1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:focusable="false"
                android:lineSpacingMultiplier="1.3"
                android:text="点击上方画面进入全屏直播；使用下方按钮切换直播线路、画面比例与播放解码等设置。"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_14" />
        </LinearLayout>

        <!-- 底部控制区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_control_bottom"
            android:orientation="vertical"
            android:padding="@dimen/vs_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSourceChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="源1"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvLineSelectChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="线路选择"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvScaleChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="画面比例"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvDecoderChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="播放解码"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTimeoutChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="超时换源"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvPreferenceChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="偏好设置"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvMultiSourceChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="多源切换"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />

                <TextView
                    android:id="@+id/tvConfigChip"
                    android:layout_width="@dimen/vs_0"
                    android:layout_height="@dimen/vs_36"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/vs_2"
                    android:background="@drawable/shape_live_control_btn"
                    android:clickable="true"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="配置切换"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
