<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_control_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部直播播放器：16:9 原始比例 -->
        <FrameLayout
            android:id="@+id/playerLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_200"
            android:background="@android:color/black">

            <xyz.doikki.videoplayer.player.VideoView
                android:id="@+id/mVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/pbLiveLoading"
                android:layout_width="@dimen/vs_40"
                android:layout_height="@dimen/vs_40"
                android:layout_gravity="center"
                android:indeterminateDrawable="@drawable/anim_loading"
                android:indeterminateOnly="true" />

            <!-- 点击播放器区域进入全屏直播 -->
            <View
                android:id="@+id/playerClickArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="false" />

            <TextView
                android:id="@+id/tvPlayerChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/vs_10"
                android:focusable="false"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="2"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_22"
                tools:text="CCTV1" />
        </FrameLayout>

        <!-- 中间留白区域 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_0"
            android:layout_weight="1" />

        <!-- 底部控制区：所有按钮同行等宽 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_live_control_bottom"
            android:orientation="horizontal"
            android:padding="@dimen/vs_6">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBackChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="点击返回"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLineSelectChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="线路选择"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvScaleChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="画面比例"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDecoderChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="播放解码"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTimeoutChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="超时换源"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvFullscreenChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="点击全屏"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMultiSourceChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="多源切换"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConfigChip"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_36"
                android:layout_margin="@dimen/vs_1"
                android:layout_weight="1"
                android:background="@drawable/shape_live_control_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="配置切换"
                android:textColor="@android:color/white"
                app:autoSizeMaxTextSize="12sp"
                app:autoSizeMinTextSize="7sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
